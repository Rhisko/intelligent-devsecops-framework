<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ report.project }} - Security Advisory Report</title>
  <style>
    :root {
      --bg: #ece8d4;
      --panel: #ffffff;
      --panel-2: #f8f6ee;
      --text: #23232c;
      --muted: #666a75;
      --border: #ddd6cb;
      --accent: #4a2dff;
      --critical: #c62839;
      --high: #d97706;
      --medium: #b28a00;
      --low: #21885a;
      --white: #ffffff;
      --shadow: 0 14px 34px rgba(38, 16, 77, .12);
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background:
        radial-gradient(circle at top right, rgba(74,45,255,.08), transparent 24%),
        radial-gradient(circle at top left, rgba(193,0,28,.08), transparent 22%),
        linear-gradient(180deg, #ece8d4 0%, #f5f5ee 100%);
      color: var(--text);
      line-height: 1.5;
    }

    body::before {
      content: "Pamulang University";
      position: fixed;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 92px;
      font-weight: 800;
      letter-spacing: .08em;
      color: rgba(74, 45, 255, 0.045);
      transform: rotate(-24deg);
      pointer-events: none;
      user-select: none;
      z-index: 0;
      white-space: nowrap;
    }

    .container {
      position: relative;
      z-index: 1;
      width: min(1680px, calc(100vw - 32px));
      margin: 24px auto 40px;
    }

    .hero {
      position: relative;
      background: linear-gradient(100deg, #c0001b 0%, #a50046 42%, #3559c7 100%);
      border: 1px solid var(--border);
      border-bottom: 4px solid #d7d21c;
      border-radius: 22px;
      padding: 28px 32px;
      box-shadow: var(--shadow);
      margin-bottom: 20px;
      overflow: hidden;
    }

    .hero::after {
      content: "PU";
      position: absolute;
      right: 28px;
      top: 18px;
      width: 96px;
      height: 96px;
      border-radius: 50%;
      display: grid;
      place-items: center;
      font-size: 34px;
      font-weight: 900;
      color: rgba(255,255,255,.18);
      border: 2px solid rgba(255,255,255,.14);
      background: radial-gradient(circle at 35% 35%, rgba(255,255,255,.08), rgba(255,255,255,.03));
      box-shadow: inset 0 0 0 2px rgba(255,255,255,.05);
    }

    .hero-brand {
      display: flex;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 16px;
    }

    .hero-logo {
      width: 72px;
      height: 72px;
      object-fit: contain;
      border-radius: 50%;
      background: rgba(255,255,255,0.10);
      border: 2px solid rgba(255,255,255,0.22);
      box-shadow: 0 8px 20px rgba(0,0,0,0.16);
      padding: 6px;
      flex: 0 0 auto;
    }

    .hero-text { min-width: 0; }

    .eyebrow {
      color: rgba(255,255,255,0.96);
      font-size: 12px;
      letter-spacing: .12em;
      text-transform: uppercase;
      margin-bottom: 8px;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 34px;
      line-height: 1.15;
      color: #ffffff;
      text-shadow: 0 2px 10px rgba(0,0,0,0.18);
    }

    .subtitle {
      color: rgba(255,255,255,0.97);
      max-width: 980px;
      font-size: 15px;
    }

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 14px;
      margin: 20px 0 8px;
    }

    .metric-card {
      background: rgba(255,255,255,.88);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 16px 18px;
      position: relative;
      overflow: hidden;
    }

    .metric-card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: linear-gradient(180deg, #d62828 0%, #e6d11f 50%, #4a2dff 100%);
    }

    .metric-label {
      color: var(--muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .08em;
      margin-bottom: 8px;
      padding-left: 8px;
    }

    .metric-value {
      font-size: 24px;
      font-weight: 700;
      padding-left: 8px;
    }

    .grid-2 {
      display: grid;
      grid-template-columns: 1.2fr .8fr;
      gap: 20px;
      margin-bottom: 20px;
    }

    .panel {
      background: linear-gradient(180deg, rgba(255,255,255,.97), rgba(249,248,242,.99));
      border: 1px solid var(--border);
      border-radius: 22px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    .panel-head {
      padding: 18px 22px 8px;
      border-bottom: 1px solid #ece6dc;
    }

    .panel-title {
      margin: 0;
      font-size: 18px;
    }

    .panel-body {
      padding: 18px 22px 22px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 72px;
      padding: 6px 12px;
      border-radius: 999px;
      font-size: 12px;
      font-weight: 700;
      letter-spacing: .03em;
      background: #7a8190;
    }

    .badge-critical { background: #fde7eb; border: 1px solid #efb2be; color: #c62839; }
    .badge-high { background: #fff0df; border: 1px solid #efc490; color: #d97706; }
    .badge-medium { background: #fff7d9; border: 1px solid #e5d087; color: #b28a00; }
    .badge-low { background: #e4f6ed; border: 1px solid #a6d7bb; color: #21885a; }
    .badge-neutral { background: #eef1f6; border: 1px solid #cfd5de; color: #6f7480; }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .chip {
      display: inline-flex;
      gap: 10px;
      align-items: center;
      border: 1px solid #dad58a;
      background: #f3efcf;
      border-radius: 14px;
      padding: 10px 12px;
    }

    .chip-label {
      color: #6b661f;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .chip-value {
      font-weight: 700;
      color: #4d4909;
    }

    .actions {
      margin: 0;
      padding-left: 20px;
    }

    .actions li {
      margin: 0 0 10px;
      color: var(--text);
    }

    .table-wrap {
      overflow: auto;
      border-radius: 0 0 22px 22px;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
      min-width: 1700px;
    }

    thead th {
      position: sticky;
      top: 0;
      z-index: 2;
      background: #f4f1e6;
      color: #393d45;
      text-align: left;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: .06em;
      padding: 14px 14px;
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody td {
      padding: 14px;
      border-bottom: 1px solid rgba(120,120,120,.08);
      vertical-align: top;
      font-size: 14px;
    }

    tbody tr:nth-child(odd) {
      background: rgba(249,248,242,.96);
    }

    tbody tr:hover {
      background: rgba(232, 223, 172, .34);
    }

    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; font-size: 12px; }
    .small { font-size: 12px; }
    .muted { color: var(--muted); }
    .center { text-align: center; }

    .title-cell {
      font-weight: 700;
      margin-bottom: 6px;
    }

    .type-pill {
      display: inline-flex;
      align-items: center;
      padding: 5px 10px;
      border-radius: 999px;
      background: #f4f4ef;
      border: 1px solid #ddd8cf;
      color: #5f6470;
      font-size: 12px;
      font-weight: 700;
    }

    .engine-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }

    .mini-pill {
      display: inline-flex;
      align-items: center;
      padding: 5px 9px;
      border-radius: 999px;
      background: #efeaff;
      border: 1px solid #d5c9ff;
      color: #4a2dff;
      font-size: 11px;
      font-weight: 700;
    }

    .footer {
      color: #6f7280;
      font-size: 12px;
      margin-top: 16px;
      padding: 0 4px;
    }

    @media (max-width: 1100px) {
      .summary-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .grid-2 { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <div class="container">
    <section class="hero">
      <div class="hero-brand">
        <img class="hero-logo" src="{{ logo_filename }}" alt="Pamulang University logo" />
        <div class="hero-text">
          <div class="eyebrow">Security Advisory Report</div>
          <h1>{{ report.project }} — Critical Findings Review</h1>
          <div class="subtitle">{{ report.executive_summary }}</div>
        </div>
      </div>

      <div class="summary-grid">
        <div class="metric-card">
          <div class="metric-label">Project</div>
          <div class="metric-value">{{ report.project }}</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Overall Risk</div>
          <div class="metric-value"><span class="{{ badge_class(report.overall_risk, 'risk') }}">{{ report.overall_risk }}</span></div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Exploitation Risk</div>
          <div class="metric-value"><span class="{{ badge_class(report.exploitation_risk, 'risk') }}">{{ report.exploitation_risk }}</span></div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Release Recommendation</div>
          <div class="metric-value"><span class="{{ badge_class(report.release_recommendation, 'risk') }}">{{ report.release_recommendation }}</span></div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Critical Findings</div>
          <div class="metric-value">{{ report.findings | length }}</div>
        </div>
        <div class="metric-card">
          <div class="metric-label">Release Blockers</div>
          <div class="metric-value">{{ blockers }}</div>
        </div>
      </div>
    </section>

    <section class="grid-2">
      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title">Risk Distribution</h2>
        </div>
        <div class="panel-body">
          <div class="muted small" style="margin-bottom:10px;">Severity</div>
          <div class="chips" style="margin-bottom:18px;">
            {% for item in severity_breakdown %}
            <div class="chip">
              <span class="chip-label">{{ item.label }}</span>
              <span class="chip-value">{{ item.value }}</span>
            </div>
            {% endfor %}
          </div>

          <div class="muted small" style="margin-bottom:10px;">Detection Engines</div>
          <div class="chips">
            {% for item in engine_breakdown %}
            <div class="chip">
              <span class="chip-label">{{ item.label }}</span>
              <span class="chip-value">{{ item.value }}</span>
            </div>
            {% endfor %}
          </div>
        </div>
      </div>

      <div class="panel">
        <div class="panel-head">
          <h2 class="panel-title">Immediate Actions</h2>
        </div>
        <div class="panel-body">
          <ol class="actions">
            {% for action in report.immediate_actions %}
            <li>{{ action }}</li>
            {% endfor %}
          </ol>
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel-head">
        <h2 class="panel-title">Detailed Findings Table</h2>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Finding ID</th>
              <th>Title & Risk Summary</th>
              <th>Component</th>
              <th>Line</th>
              <th>Severity</th>
              <th>Type</th>
              <th>Engine</th>
              <th>Exploitability</th>
              <th>Blast Radius</th>
              <th>Priority</th>
              <th>Release Blocker</th>
              <th>Recommended Fix</th>
              <th>Developer Action</th>
              <th>Rationale</th>
            </tr>
          </thead>
          <tbody>
            {% for finding in report.findings %}
            <tr>
              <td class="mono">{{ finding.finding_id }}</td>
              <td>
                <div class="title-cell">{{ finding.title }}</div>
                <div class="muted small">{{ finding.risk_summary }}</div>
              </td>
              <td class="mono">{{ finding.component }}</td>
              <td class="center">{{ finding.line if finding.line is not none else "—" }}</td>
              <td><span class="{{ badge_class(finding.severity, 'risk') }}">{{ finding.severity }}</span></td>
              <td><span class="type-pill">{{ finding.issue_type }}</span></td>
              <td>
                <div class="engine-list">
                  {% for eng in split_engines(finding.engine) %}
                  <span class="mini-pill">{{ eng }}</span>
                  {% endfor %}
                </div>
              </td>
              <td><span class="{{ badge_class(finding.exploitability, 'risk') }}">{{ finding.exploitability }}</span></td>
              <td><span class="{{ badge_class(finding.blast_radius, 'risk') }}">{{ finding.blast_radius }}</span></td>
              <td><span class="{{ badge_class(finding.remediation_priority, 'risk') }}">{{ finding.remediation_priority }}</span></td>
              <td>
                <span class="{{ badge_class(finding.release_blocker, 'risk') }}">
                  {{ "YES" if finding.release_blocker else "NO" }}
                </span>
              </td>
              <td>{{ finding.recommended_fix }}</td>
              <td>{{ finding.developer_action }}</td>
              <td>{{ finding.rationale }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>

    <div class="footer">
      Generated on {{ generated_at }} • Designed for web server publishing, engineering triage, and alert downstream processing.
    </div>
  </div>
</body>
</html>